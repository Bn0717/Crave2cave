rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Receipts/payment proof: only the uploader can read/write their own
    // folder; admins can read everyone's (needed to verify payments).
    match /uploads/{uid}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
